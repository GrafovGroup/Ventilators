# Public origin used in canonical URLs; no secret values here.
NEXT_PUBLIC_SITE_URL=https://ventilators.ca
# Public form ID supplied by the owner. Omit to keep the approved default.
NEXT_PUBLIC_FORMSPREE_FORM_ID=mvkaapjj
# No private API key is needed or included in the static export.
# Default builds are noindex. Use this explicit flag only for the authorized
# public release and run check:export with the same flag.
# VENTILATORS_PUBLIC_RELEASE=1
# Optional overrides for the public ownership tokens tracked in
# src/content/search-verification.json. Empty values omit that provider.
# Tokens only, not complete meta tags. Emitted only in public release builds.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# These are build-time settings: rebuild and redeploy after changing them.
# Analytics are not implemented or enabled. Do not add identifiers until the
# measurement plan and consent behavior in docs/OPERATIONS.md are approved.
