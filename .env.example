# Public origin used in canonical URLs; no secret values here.
NEXT_PUBLIC_SITE_URL=https://ventilators.ca
# Intentionally no live RFQ endpoint in Phase 1A. A client URL alone must never
# enable delivery. Implement the reviewed endpoint contract in docs/RFQ_ENDPOINT.md.
# NEXT_PUBLIC_RFQ_ENDPOINT=
# Default builds are noindex. Use this explicit flag only for the authorized
# public release and run check:export with the same flag.
# VENTILATORS_PUBLIC_RELEASE=1
# Do not add analytics identifiers until consent behavior is approved.
