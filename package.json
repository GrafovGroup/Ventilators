{
  "name": "ventilators-ca",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:export": "node --import tsx scripts/check-export.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:build": "node scripts/generate-photo-variants.mjs",
    "check:performance": "node --import tsx scripts/check-performance.ts",
    "check:live": "node --import tsx scripts/check-live.ts",
    "check:audit": "node scripts/check-audit.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@formspree/react": "3.0.0",
    "next": "16.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.6.2",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
